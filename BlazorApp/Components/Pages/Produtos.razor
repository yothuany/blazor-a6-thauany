@page "/produtos"

<h3 class="mb-4">Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Cadastro de produto">
            <FormProduto OnProdutoValido="ReceberProduto" />
        </Cartao>
    </div>

    <div class="col-md-8">
        @if (produtos.Count == 0)
        {
            <p class="text-muted">Nenhum produto cadastrado.</p>
        }
        else
        {
            <TabelaProdutos Produtos="produtos" />
        }
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    private void ReceberProduto(Produto produto)
    {
        produtos.Add(produto);
    }
}
