@page "/produtos"
@using BlazorApp.Components
@using BlazorApp.Components.Models
@using BlazorApp.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LojaContext> DbFactory

<h3 class="mb-4">Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Cadastro de produto">
            <FormProduto OnProdutoValido="ReceberProduto" />
        </Cartao>
    </div>

    <div class="col-md-8">
        @if (carregando)
        {
            <p class="text-muted">Carregando produtos...</p>
        }
        else if (produtos.Count == 0)
        {
            <p class="text-muted">Nenhum produto cadastrado.</p>
        }
        else
        {
            <TabelaProdutos Produtos="produtos" OnExcluir="ExcluirProduto" />
        }
    </div>
</div>

@code {
    private List<Produto> produtos = new();
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CarregarProdutos();
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarProdutos()
    {
        // Cada operação usa seu próprio DbContext.
        await using var contexto = await DbFactory.CreateDbContextAsync();

        produtos = await contexto.Produtos
            .AsNoTracking()
            .OrderBy(p => p.Nome)
            .ToListAsync();
    }

    private async Task ReceberProduto(Produto produto)
    {
        await using var contexto = await DbFactory.CreateDbContextAsync();

        contexto.Produtos.Add(produto);
        await contexto.SaveChangesAsync();

        await CarregarProdutos();
    }

    private async Task ExcluirProduto(Produto produto)
    {
        await using var contexto = await DbFactory.CreateDbContextAsync();

        var produtoBanco = await contexto.Produtos.FindAsync(produto.Id);

        if (produtoBanco is null)
        {
            return;
        }

        contexto.Produtos.Remove(produtoBanco);
        await contexto.SaveChangesAsync();

        await CarregarProdutos();
    }
}
